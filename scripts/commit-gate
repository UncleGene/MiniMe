#!/usr/bin/env python3
"""Agent commit gate for Claude Code and Codex (Decision 13).

A PreToolUse hook for Bash. It blocks `git commit` when the session has loaded
a MiniMe skill but the current turn lacks a commit skill or any commit check
skill: doc-sync, scope-boundary, simplifier and reviewer. A turn whose reply
starts a line with `Commit tier: light` may skip the reviewer; the turn's latest
`Commit tier:` line counts, so a later `Commit tier: full` withdraws it.
Sessions that never loaded
a MiniMe skill are not affected. Exit 2 blocks the
call and shows the message to the agent.

In Claude Code it is also a Stop hook: a turn that loaded a MiniMe skill may
not end without `Recommended next action:` in its last message, nor with a
question as the last prose line before it when the turn has not used the
choice UI. It blocks once per stop, so
the agent's fix ends the turn.

In Claude Code it also gates the choice UI (`AskUserQuestion`) in a session
that loaded a MiniMe skill: one question per call, the question carries
`Default if no reply:`, each option's description carries `Pros:`, `Cons:`
and `Locks in:`, and no text outside an option's `Affects:` cites a workflow
item by number or code (the minime-decision-prompt shape).

After a compaction in a session that loaded a MiniMe skill, the Claude Code
SessionStart hook (matcher `compact`) reminds the agent that those skills are
still in force, and the Stop hook blocks once until a reply starts a line with
`Ledger:`, the minime step-0 orchestration ledger.
"""
import json
import re
import sys
import time
from typing import NamedTuple

SKILL_NAME = r"minime(?:-[a-z]+)*"
COMMIT_SKILLS = {"minime-project-commit", "minime-self-commit"}
# Each check is satisfied by any skill in its set; doc-sync's diff scope runs
# through doc-check.
LIGHT_CHECKS = {"minime-doc-sync": {"minime-doc-sync", "minime-doc-check"},
                "minime-scope-boundary": {"minime-scope-boundary"},
                "minime-code-simplifier": {"minime-code-simplifier"}}
FULL_CHECKS = {**LIGHT_CHECKS, "minime-code-reviewer": {"minime-code-reviewer"}}
# A tier statement starts a line (bold or list markers allowed), so a reply
# that quotes the rule mid-sentence does not choose a tier.
TIER_RE = re.compile(r"^[\W_]{0,4}commit tier\W{0,4}(light|full)(?![\w-])", re.I | re.M)
GIT_COMMIT_RE = re.compile(r"(?:^|&&|\|\|?|;|\n|\$\(|`)\s*git\s+(?:-[cC]\s+\S+\s+)*commit\b")
# A heredoc body is data unless the heredoc feeds a shell, so a commit it only
# mentions, as in a script or document written through one, is not run. Any
# shell, eval or source word on the `<<` line counts as feeding one, even as an
# argument: the gate errs toward checking the body.
HEREDOC_RE = re.compile(r"(?<!<)<<-?[ \t]*(['\"]?)(\w+)\1[^\n]*\n(.*?\n)?[ \t]*\2[ \t]*(?=\n|$)", re.S)
SHELL_RE = re.compile(r"\b(?:(?:ba|z|da|k|t?c|s)?sh|fish|eval|source|exec)\b|(?:^|[\s;&|(])\.\s")
SLASH_SKILL_RE = re.compile(rf"<command-name>/?({SKILL_NAME})</command-name>")
BASE_DIR_SKILL_RE = re.compile(rf"Base directory for this skill: \S*/({SKILL_NAME})\b")
INJECTED_SKILL_RE = re.compile(rf"<skill>\s*<name>({SKILL_NAME})</name>")
DOLLAR_SKILL_RE = re.compile(rf"\$({SKILL_NAME})\b")
SKILL_FILE_RE = re.compile(rf"skills/({SKILL_NAME})/SKILL\.md")
# A read counts only when a read command starts a shell segment and names the
# SKILL.md in that segment; text that merely mentions such a command, as in a
# heredoc, does not. Every SKILL.md the segment names counts (`cat a b c`).
# Codex commands may also start at its exec wrapper's `cmd` string.
# A segment also ends at an escaped `\n`, the newline inside Codex JSON args.
_SKILL_READ = r"\s*(?:cat|sed|head|tail|less|nl|awk|bat)\b((?:(?!\\n)[^\n;&|])*)"
SKILL_READ_RE = re.compile(r"(?:^|&&|\|\|?|;|\n|\$\()" + _SKILL_READ)
CODEX_SKILL_READ_RE = re.compile(r"(?:^|&&|\|\|?|;|\n|\$\(|cmd\W{1,4})" + _SKILL_READ)
RECHECKS = 8
RECHECK_SECONDS = 0.25
_STAGE_NOTE = (" A blocked command runs none of its parts, so a `git add` chained to the commit "
               "did not run either: stage in its own call, then commit.")
MESSAGE = ("MiniMe commit gate: this turn has not loaded a commit skill. Read and follow "
           "minime-project-commit (minime-self-commit in the MiniMe repo), then commit. "
           "The read must be its own earlier tool call; one in the commit's command "
           "comes too late." + _STAGE_NOTE)
CHECKS_MESSAGE = ("MiniMe commit gate: this turn has not run {missing}. Run each through its "
                  "skill before committing. Only a turn whose latest tier line is `Commit tier: light` "
                  "(the light tier in minime-project-commit) may skip the reviewer." + _STAGE_NOTE)
NEXT_ACTION_RE = re.compile(r"recommended next action", re.I)
STOP_MESSAGE = ("MiniMe next-action gate: this turn loaded a MiniMe skill, so end it with "
                "`Recommended next action: <one concrete step>`. Add that line now.")
PROSE_QUESTION_MESSAGE = ("MiniMe question gate: this turn ends on a prose question. Ask it through "
                          "the choice UI (AskUserQuestion) in the minime-decision-prompt shape, or "
                          "restate the line so it is not a question.")
# The ledger marker: `Ledger:` or `Orchestration ledger:` starting a line, list
# and emphasis markers allowed, so a sentence that starts with "Ledger" does not count.
LEDGER_RE = re.compile(r"^[ \t>*_#-]{0,8}(?:orchestration )?ledger[*_]*\s*:", re.I | re.M)
LEDGER_MESSAGE = ("MiniMe ledger gate: the conversation was compacted and no reply since has started "
                  "a line with `Ledger:`. Re-read the minime skill and write its step-0 orchestration "
                  "ledger now.")
COMPACT_REMINDER = ("MiniMe: this session was compacted after loading {skills}. They are still in "
                    "force, not background. Before continuing, re-read the minime skill (and "
                    "minime-decision-prompt before any question), then write the step-0 "
                    "orchestration ledger starting with a line `Ledger:`; reflection (step 1) is "
                    "due if 3+ commits happened since the last one.")
CHOICE_UI = "AskUserQuestion"
QUESTION_MARKER = "default if no reply:"
OPTION_MARKERS = ("pros:", "cons:", "locks in:")
# A workflow item cited by number ("Decision 13", "item 6") or upper-case code ("Q7", "M3", "REQ-005").
NUMBERED_REF_RE = re.compile(r"\b(?:(?i:decision|requirement|milestone|item|question|step|phase|finding|"
                             r"option|gate|rule|slice|task)s?\s+#?\d+|(?:REQ|ADR|DEC|[QRDM])-?\d{1,3})\b")
# An option's `Affects:` text, up to the next shape marker.
AFFECTS_RE = re.compile(r"affects:.*?(?=pros:|cons:|locks in:|$)", re.I | re.S)
CHOICE_MESSAGE = ("MiniMe question gate: {problem}. Follow minime-decision-prompt: one question per "
                  "call, the question ends with `Default if no reply: <option or stop>`, and each "
                  "option description carries `Pros:`, `Cons:` and `Locks in:` (add `Affects:` "
                  "with path:line where an artifact changes).")


def _read_skills(read_re: re.Pattern, command: str) -> set[str]:
    """Skills whose SKILL.md a read segment of the command names."""
    return {name for segment in read_re.findall(command) for name in SKILL_FILE_RE.findall(segment)}


def _claude_skills(record: dict) -> tuple[set[str], bool]:
    """Skills a Claude Code record loads, and whether it starts a new user turn."""
    if record.get("isSidechain"):
        return set(), False
    message = record.get("message") or {}
    content = message.get("content")
    blocks = content if isinstance(content, list) else [{"type": "text", "text": content or ""}]
    found: set[str] = set()
    if record.get("type") == "user":
        text = "\n".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
        found.update(SLASH_SKILL_RE.findall(text), BASE_DIR_SKILL_RE.findall(text))
        new_turn = bool(text.strip()) and not record.get("isMeta") and not BASE_DIR_SKILL_RE.search(text)
        return found, new_turn
    for block in blocks:
        if not isinstance(block, dict) or block.get("type") != "tool_use":
            continue
        name, data = block.get("name"), block.get("input") or {}
        if name == "Skill" and re.fullmatch(SKILL_NAME, str(data.get("skill", ""))):
            found.add(data["skill"])
        elif name == "Read":
            found.update(SKILL_FILE_RE.findall(str(data.get("file_path", ""))))
        elif name == "Bash":
            found.update(_read_skills(SKILL_READ_RE, str(data.get("command", ""))))
    return found, False


def _codex_skills(record: dict) -> tuple[set[str], bool]:
    """Skills a Codex record loads, and whether it starts a new task (turn)."""
    payload = record.get("payload")
    if not isinstance(payload, dict):
        return set(), False
    kind = payload.get("type")
    if kind == "task_started":
        return set(), True
    if kind == "message" and payload.get("role") == "user":
        text = json.dumps(payload.get("content"))
        return set(INJECTED_SKILL_RE.findall(text.replace("\\n", "\n")) + DOLLAR_SKILL_RE.findall(text)), False
    if kind in ("function_call", "custom_tool_call"):
        return _read_skills(CODEX_SKILL_READ_RE, str(payload.get("arguments") or payload.get("input") or "")), False
    return set(), False


def _codex_text(record: dict) -> str:
    """The text of a Codex assistant message."""
    payload = record.get("payload")
    if not isinstance(payload, dict) or payload.get("type") != "message" or payload.get("role") != "assistant":
        return ""
    content = payload.get("content")
    return "\n".join(b.get("text", "") for b in content if isinstance(b, dict)) if isinstance(content, list) else ""


def _claude_texts(record: dict) -> list[str]:
    """The non-empty text blocks of a main-thread Claude Code reply."""
    if record.get("type") != "assistant" or record.get("isSidechain"):
        return []
    content = (record.get("message") or {}).get("content")
    return [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"
            and b.get("text", "").strip()] if isinstance(content, list) else []


def _used_choice_ui(record: dict) -> bool:
    """Whether a main-thread Claude Code record calls the choice UI."""
    content = (record.get("message") or {}).get("content")
    return (record.get("type") == "assistant" and not record.get("isSidechain") and isinstance(content, list)
            and any(isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == CHOICE_UI
                    for b in content))


class Transcript(NamedTuple):
    session: set[str]  # MiniMe skills loaded anywhere in the session
    turn: set[str]  # ...and in the current turn
    final: str  # the turn's latest reply text
    light: bool  # the turn's latest tier statement is `Commit tier: light`
    asked: bool  # the turn used the choice UI
    ledger_due: bool  # compacted after a MiniMe load, with no `Ledger:` line since


def _loaded_skills(path: str) -> Transcript:
    """What the transcript shows about MiniMe skill use."""
    session: set[str] = set()
    turn: set[str] = set()
    final = ""
    light = asked = ledger_due = False
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(record, dict):
                continue
            found, new_turn = (_codex_skills if "payload" in record else _claude_skills)(record)
            if new_turn:
                turn, final, light, asked = set(), "", False, False
            session |= found
            turn |= found
            texts = [_codex_text(record)] if "payload" in record else _claude_texts(record)
            final = texts[-1] if texts and texts[-1] else final
            tiers = TIER_RE.findall("\n".join(texts))
            light = tiers[-1].lower() == "light" if tiers else light
            asked = asked or _used_choice_ui(record)
            if record.get("subtype") == "compact_boundary":
                ledger_due = bool(session)
            elif LEDGER_RE.search("\n".join(texts)):
                ledger_due = False
    return Transcript(session, turn, final, light, asked, ledger_due)


def _executed_text(command: str) -> str:
    """The command without the bodies of heredocs that do not feed a shell."""
    def strip(match: re.Match) -> str:
        line_start = command.rfind("\n", 0, match.start()) + 1
        header = command[line_start:command.index("\n", match.start())]
        if match.group(3) is None or SHELL_RE.search(header):
            return match.group(0)
        body_start, body_end = match.start(3) - match.start(), match.end(3) - match.start()
        return match.group(0)[:body_start] + match.group(0)[body_end:]
    return HEREDOC_RE.sub(strip, command)


def _commit_problem(session: set[str], turn: set[str], light: bool) -> str:
    """Why the turn may not commit yet, or "" when it may."""
    if not session:
        return ""
    if not turn & COMMIT_SKILLS:
        return MESSAGE
    checks = LIGHT_CHECKS if light else FULL_CHECKS
    missing = [name for name, satisfied_by in checks.items() if not turn & satisfied_by]
    return CHECKS_MESSAGE.format(missing=", ".join(missing)) if missing else ""


def blocked(event: dict) -> str:
    """The block message for a Bash event, or "" to allow it."""
    if event.get("tool_name") != "Bash":
        return ""
    if not GIT_COMMIT_RE.search(_executed_text(str((event.get("tool_input") or {}).get("command", "")))):
        return ""
    # A commit sent in the same parallel batch as the skill read can reach the
    # hook before the read is written, so re-read briefly before blocking.
    problem = ""
    for attempt in range(RECHECKS + 1):
        try:
            seen = _loaded_skills(event["transcript_path"])
        except (KeyError, TypeError, OSError):
            return ""  # No readable transcript: nothing to judge against.
        problem = _commit_problem(seen.session, seen.turn, seen.light)
        if not problem:
            return ""
        if attempt < RECHECKS:
            time.sleep(RECHECK_SECONDS)
    return problem


def _choice_problem(questions: object) -> str:
    """What a choice-UI call's questions lack, or "" when they fit the shape."""
    if not isinstance(questions, list) or len(questions) != 1 or not isinstance(questions[0], dict):
        return "a choice-UI call must ask exactly one question"
    question = questions[0]
    if not isinstance(question.get("options"), list) or len(question["options"]) < 2:
        return "the question needs at least two options"
    if QUESTION_MARKER not in str(question.get("question", "")).lower():
        return "the question lacks `Default if no reply:`"
    for option in question["options"]:
        description = str(option.get("description", "")).lower() if isinstance(option, dict) else ""
        missing = [marker for marker in OPTION_MARKERS if marker not in description]
        if missing:
            label = option.get("label", "?") if isinstance(option, dict) else "?"
            return f"option {label!r} lacks {', '.join(m.capitalize() for m in missing)}"
    texts = [str(question.get(key, "")) for key in ("question", "header")]
    for option in question["options"]:
        texts += [str(option.get("label", "")), AFFECTS_RE.sub("", str(option.get("description", "")))]
    for text in texts:
        if match := NUMBERED_REF_RE.search(text):
            return (f"it cites workflow item {match.group(0)!r} by number; say in plain words what it "
                    "is (exact locations go only in `Affects:`)")
    return ""


def choice_blocked(event: dict) -> str:
    """The block message for a choice-UI call, or "" to allow it."""
    try:
        session = _loaded_skills(event["transcript_path"]).session
    except (KeyError, TypeError, OSError):
        return ""
    if not session:
        return ""
    problem = _choice_problem((event.get("tool_input") or {}).get("questions"))
    return CHOICE_MESSAGE.format(problem=problem) if problem else ""


def _ends_on_question(text: str) -> bool:
    """Whether a reply's last prose line, before any next-action line, is a
    question. Fenced code, quotes, headings and table rows are not prose."""
    fenced = False
    last = ""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith(("```", "~~~")):
            fenced = not fenced
        elif NEXT_ACTION_RE.search(stripped):
            break
        elif stripped and not fenced:
            last = stripped
    return bool(last) and not last.startswith((">", "#", "|")) and "|" not in last \
        and last.rstrip("*_").endswith("?")


def stop_blocked(event: dict) -> str:
    """The block message for a Stop event, or "" to let the turn end."""
    if event.get("stop_hook_active"):
        return ""  # The agent is already continuing from this hook's block.
    # The final reply can reach the transcript just after the hook starts.
    message = ""
    for attempt in range(RECHECKS + 1):
        try:
            seen = _loaded_skills(event["transcript_path"])
        except (KeyError, TypeError, OSError):
            return ""
        messages = [LEDGER_MESSAGE] if seen.ledger_due else []
        if seen.turn and not NEXT_ACTION_RE.search(seen.final):
            messages.append(STOP_MESSAGE)
        if seen.turn and not seen.asked and _ends_on_question(seen.final):
            messages.append(PROSE_QUESTION_MESSAGE)
        message = " ".join(messages)
        if not message:
            return ""
        if attempt < RECHECKS:
            time.sleep(RECHECK_SECONDS)
    return message


def compact_reminder(event: dict) -> str:
    """The context to add after a compaction in a MiniMe session, or ""."""
    if event.get("source") != "compact":
        return ""
    try:
        session = _loaded_skills(event["transcript_path"]).session
    except (KeyError, TypeError, OSError):
        return ""
    return COMPACT_REMINDER.format(skills=", ".join(sorted(session))) if session else ""


def main() -> int:
    try:
        event = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0
    if not isinstance(event, dict):
        return 0
    if event.get("hook_event_name") == "SessionStart":
        reminder = compact_reminder(event)
        if reminder:
            print(reminder)  # SessionStart stdout becomes context for the agent.
        return 0
    if event.get("hook_event_name") == "Stop":
        message = stop_blocked(event)
    elif event.get("tool_name") == CHOICE_UI:
        message = choice_blocked(event)
    else:
        message = blocked(event)
    if message:
        print(message, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
