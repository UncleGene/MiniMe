#!/usr/bin/env python3
"""Pre-commit slop scan (Decision 12).

Blocks mechanical slop on added lines of staged source files: unfinished-code
markers, skipped or focused tests, blanket type/lint suppressions and leftover
debugger calls. Installed as a user-level git hook; it then runs the
repository's own pre-commit hook. Bypass with `git commit --no-verify` or
SLOP_SCAN=off; exempt paths with the `-slop-scan` git attribute.
"""
import os
import re
import subprocess
import sys

UNFINISHED = ("unfinished-code", re.compile(r"\b(TODO|FIXME|XXX)\b"))
RULES = {
    "python": [
        UNFINISHED,
        ("unfinished-code", re.compile(r"\braise NotImplementedError\b")),
        ("skipped-test", re.compile(r"@unittest\.(skip\w*|expectedFailure)\b|\bpytest\.(mark\.)?(skip|xfail)\b")),
        ("blanket-suppression", re.compile(r"#\s*type:\s*ignore(?!\[)|#\s*noqa(?!:)")),
        ("debugger", re.compile(r"\bbreakpoint\(\)|\bpdb\.set_trace\(\)|^\s*import pdb\b")),
    ],
    "javascript": [
        UNFINISHED,
        ("skipped-test", re.compile(r"\b(it|test|describe|context)\.(skip|only)\(|\bx(it|describe|test)\(")),
        ("blanket-suppression", re.compile(r"@ts-ignore|@ts-nocheck|eslint-disable(?![^\n]*--)")),
        ("debugger", re.compile(r"^\s*debugger;?\s*$")),
    ],
    "ruby": [
        UNFINISHED,
        ("unfinished-code", re.compile(r"\braise NotImplementedError\b")),
        ("skipped-test", re.compile(r"^\s*(xit|xdescribe|xcontext|skip|pending)\b")),
        ("blanket-suppression", re.compile(r"rubocop:disable(?![^\n]*--)")),
        ("debugger", re.compile(r"\bbinding\.(pry|irb)\b|^\s*(byebug|debugger)\b")),
    ],
}
EXTENSIONS = {
    ".py": "python",
    ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript", ".cjs": "javascript",
    ".ts": "javascript", ".tsx": "javascript",
    ".rb": "ruby", ".rake": "ruby",
}
HUNK = re.compile(r"^@@ -\S+ \+(\d+)")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def exempt(paths):
    if not paths:
        return set()
    output = git("check-attr", "slop-scan", "--", *paths)
    return {line.split(": ")[0] for line in output.splitlines() if line.endswith(": unset")}


def findings():
    diff = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff", "--diff-filter=AM")
    added, path, number = [], None, 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@"):
            match = HUNK.match(line)
            number = int(match.group(1)) if match else 0
        elif line.startswith("+") and path:
            added.append((path, number, line[1:]))
            number += 1
    paths = sorted({p for p, _, _ in added if os.path.splitext(p)[1] in EXTENSIONS})
    skipped = exempt(paths)
    for path, number, text in added:
        layer = EXTENSIONS.get(os.path.splitext(path)[1])
        if not layer or path in skipped:
            continue
        for kind, pattern in RULES[layer]:
            if pattern.search(text):
                yield f"{path}:{number}: {kind}: {text.strip()[:120]}"
                break


def chain():
    hook = os.path.join(git("rev-parse", "--git-common-dir").strip(), "hooks", "pre-commit")
    if os.path.isfile(hook) and os.access(hook, os.X_OK):
        os.execv(hook, [hook, *sys.argv[1:]])
    sys.exit(0)


def main():
    if os.environ.get("SLOP_SCAN") != "off":
        problems = list(findings())
        if problems:
            sys.stderr.write("Commit blocked by the slop scan:\n")
            sys.stderr.write("".join(f"  {problem}\n" for problem in problems))
            sys.stderr.write("Fix them, mark generated paths with the -slop-scan git attribute,\n"
                             "or bypass once with SLOP_SCAN=off or git commit --no-verify.\n")
            sys.exit(1)
    chain()


if __name__ == "__main__":
    main()
